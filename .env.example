# Copy to .env, then uncomment and set the keys you need. Do not commit .env.
#
# ./manage.py runs tools/fixusb.py first, which rewrites the generated block at the top of
# .env on every launch (SOWBOT_SAFETY_ACK, GPS_*, MCU_PORT, USB_CAM_*, AXIS_CAM_ENABLED,
# USER_ID, GROUP_ID, IS_JETSON, TMAP2_FILE). Do not edit those lines: changes are lost.
# NTRIP_ENABLED is in that block, but its current value is kept, so set it once here.
# Every key below is yours and is kept as written.

# ArduPilot path (LEVIA-H7). Setting this selects real hardware with the MAVLink bridge:
# EKF3 localises, FusionCore is not launched, and fixusb.py forces the SBC-side GPS and MCU
# ports to virtual. Use a stable device path. Unset runs sim, or the legacy ESP32 path.
#MAVLINK_ENDPOINT=/dev/serial/by-id/CHANGE_ME
#MAVLINK_BAUD=115200

# Lets the bridge's fc/arm and fc/set_guided ROS services act. Off by default. fc/disarm always
# works. Any node on the ROS graph can call them, so leave this off unless you need it.
#MAVLINK_ALLOW_ARM=true

# Required in hardware mode: manage.py refuses to start without it, because the dashboard
# has a joystick and soft e-stop. SOWBOT_UI_ALLOW_OPEN=1 accepts an open dashboard on a
# private network instead.
#SOWBOT_UI_PASSWORD=CHANGE_ME
#SOWBOT_UI_ALLOW_OPEN=1

# Surveyed position of the topological map's (0, 0), in degrees, and the direction of the map
# x axis counter-clockwise from east. Set both coordinates or neither. Without them map->odom
# is an identity transform and map waypoints are offset from the robot.
#MAP_ORIGIN_LAT=
#MAP_ORIGIN_LON=
#MAP_YAW_DEG=0

# NTRIP corrections: fill in src/devkit_bringup/config/ntrip.yaml first. Needs the
# ntrip_client package in the image. Use a fixed-position mountpoint on the ArduPilot path.
#NTRIP_ENABLED=true

# Network and exposure.
# DDS_INTERFACE: force peer-to-peer DDS on a named interface.
# TOOLS_BIND: address for the unauthenticated tool ports (default 127.0.0.1).
#DDS_INTERFACE=
#TOOLS_BIND=

# Simulation only. FORCE_SIM=1 keeps the sim stack even with hardware attached.
# FIELD_DATUM_* is used only when generating the sim world and has no effect on a real robot.
#FORCE_SIM=1
#FIELD_DATUM_LAT=
#FIELD_DATUM_LON=
#FIELD_DATUM_ALT=
